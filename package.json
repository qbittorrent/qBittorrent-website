{
  "name": "qBittorrent-website",
  "description": "qBittorrent website",
  "repository": {
    "type": "git",
    "url": "https://github.com/qbittorrent/qBittorrent-website.git"
  },
  "scripts": {
    "build": "eleventy",
    "check-html": "html-validate _site/*.html",
    "format": "prettier --write **.css **.json",
    "lint": "tsc --noEmit && eslint --cache src/scripts/**.ts && stylelint --cache **/*.css",
    "serve": "eleventy --serve"
  },
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "eslint": "^10.15.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "js-beautify": "^2.0.3",
    "markdown-it-anchor": "^10.1.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "workspaces": [
    "atom_generator"
  ]
}
